# ─────────────────────────────────────────────────────────────────────────────
# AgentSites — the ONE configuration file (spec §4, §22.6).
# Copy to .env (make env). Never commit .env. Every ${...} below is expanded by Laravel.
# Lines marked [KEY NEEDED] are the credentials checklist for the operator.
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform ────────────────────────────────────────────────────────────────
# THE ONLY PLACE THE BASE DOMAIN LIVES. app./admin./api./cdn./staging./{slug}. hosts,
# cookies, CORS, OAuth redirects, webhooks, email links and sitemaps derive from it.
PLATFORM_BASE_DOMAIN=example.com
PLATFORM_ENV=production

# Caddy host ports. Stay off 80/443 until the legacy-platform cutover is approved.
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8444

# Hosts that remain on the legacy platform, comma-separated (from docs/DISCOVERY.md).
# If the apex is listed, the legacy platform keeps it and the landing page lives on app.
# Example after cutover: LEGACY_HOSTS="example.com, www.example.com"
LEGACY_HOSTS=
# Where Caddy proxies those hosts (the legacy nginx moved to a local port at cutover).
LEGACY_UPSTREAM=host.docker.internal:8088

# ── TLS / DNS ──────────────────────────────────────────────────────────────
ACME_EMAIL=ops@example.com
# [KEY NEEDED] Cloudflare API token, scoped Zone:DNS:Edit + Zone:Zone:Read on the base zone (DNS-01 wildcard).
CLOUDFLARE_API_TOKEN=

# ── Laravel ────────────────────────────────────────────────────────────────
APP_NAME=AgentSites
APP_ENV=production
# base64:$(openssl rand -base64 32) — generated by infra/scripts/bootstrap.sh
APP_KEY=
APP_DEBUG=false
# APP_URL is derived (https://app.${PLATFORM_BASE_DOMAIN}); set it only for local dev.
APP_TIMEZONE=Asia/Dubai
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# ── Database (PostgreSQL 16, single database, tenant_id row scoping) ────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=platform
DB_USERNAME=platform
# generated by infra/scripts/bootstrap.sh (openssl rand -hex 24)
DB_PASSWORD=

# ── Redis 7 (cache, sessions, queues via Horizon) ───────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# SESSION_DOMAIN stays unset on purpose: cookies are scoped per host (app/admin/tenant isolation).
SESSION_SECURE_COOKIE=true
BROADCAST_CONNECTION=log

# ── Media (local disk today; S3-compatible is an env change) ───────────────
FILESYSTEM_DISK=local
MEDIA_DISK=local
MEDIA_ROOT=/srv/platform/media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-central-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Email (Postmark in production; log locally; Mailpit on staging) ─────────
# [KEY NEEDED] Postmark server token + a verified sending domain on the base domain (SPF/DKIM/DMARC).
MAIL_MAILER=log
POSTMARK_TOKEN=
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS is derived (no-reply@${PLATFORM_BASE_DOMAIN}); MAIL_FROM_NAME defaults to APP_NAME.

# ── Auth ───────────────────────────────────────────────────────────────────
# [KEY NEEDED] Google OAuth client (redirect URI: https://app.<base>/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── WhatsApp (360dialog; NullNotifier when provider=null) ──────────────────
# [KEY NEEDED] 360dialog API key + the WhatsApp Business sender number (E.164).
WHATSAPP_PROVIDER=null
DIALOG360_API_KEY=
WHATSAPP_SENDER=

# ── Payments (Stripe test mode; Tap/Telr adapters stubbed) ─────────────────
# [KEY NEEDED] Stripe test publishable + secret keys and the webhook signing secret
# (webhook URL: https://api.<base>/webhooks/stripe).
PAYMENT_PROVIDER=stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
TAP_SECRET_KEY=
TELR_STORE_ID=
TELR_AUTH_KEY=
BILLING_TRN=

# ── Captcha (Cloudflare Turnstile) ─────────────────────────────────────────
# [KEY NEEDED] Turnstile site key + secret key for the base domain and its subdomains.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI content (Anthropic; TemplateGenerator fallback never fails) ─────────
# [KEY NEEDED] Anthropic API key. CONTENT_GENERATOR=template needs no key.
CONTENT_GENERATOR=template
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Observability (self-hosted GlitchTip + Uptime Kuma) ────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Backups ────────────────────────────────────────────────────────────────
# [KEY NEEDED] an off-server destination for nightly backups (rclone remote, e.g. b2:bucket/platform).
BACKUP_RCLONE_REMOTE=
BACKUP_RETENTION_DAYS=30
