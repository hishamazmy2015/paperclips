<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <!-- Coverage is measured on the areas spec §19 gates at ≥ 90 % lines (Tenancy, Provisioning,
         Domains, Billing); CI runs pest with coverage (pcov) and a 90 % minimum. -->
    <source>
        <include>
            <directory>app/Tenancy</directory>
            <directory>app/Provisioning</directory>
            <directory>app/Domains</directory>
            <directory>app/Billing</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:63ZdgVcH7yNB0UQ/gCbQo6jrz/3rDuQEVgOt5mBe3lU="/>
        <env name="PLATFORM_BASE_DOMAIN" value="example.test"/>
        <env name="LEGACY_HOSTS" value=""/>
        <env name="MEDIA_ROOT" value="storage/app"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run on PostgreSQL 16 like production (partitioning, JSONB, GIN). Local: apt install postgresql-16;
             createuser platform (password platform) + createdb platform_test. CI: the postgres service in the workflow. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="platform_test"/>
        <env name="DB_USERNAME" value="platform"/>
        <env name="DB_PASSWORD" value="platform"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
